# ===============================
# Core Database
# ===============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=videos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===============================
# Exposed Ports (host -> container)
# ===============================
DB_SERVICE_PORT=8001
AUDIO_TEXT_SERVICE_PORT=8002
YOUTUBE_AUDIO_SERVICE_PORT=8003
RAG_INDEXER_PORT=8005
CHAT_SERVICE_PORT=8006
QDRANT_ADMIN_PORT=8007
QDRANT_PORT=6333
FRONTEND_PORT=8080
API_GATEWAY_PORT=8082
PGADMIN_PORT=5050
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ===============================
# Storage
# ===============================
AUDIO_DIR=downloaded_audio
TEXT_DIR=downloaded_text

# ===============================
# External LLM (Ollama)
# IMPORTANT:
# - If Ollama is remote (Tailscale), use the remote IP or MagicDNS hostname.
# - If Ollama runs on the same Docker host, use host.docker.internal on Mac/Windows.
# ===============================
OLLAMA_URL=http://100.100.100.100:11434
OLLAMA_MODEL=llama3.2

# ===============================
# Public URL (Cloudflare / reverse proxy)
# Used for Grafana and Prometheus subpath configuration.
# ===============================
PUBLIC_URL=https://bold-quokka.mitrisoft.ro
CORS_ALLOW_ORIGIN=https://bold-quokka.mitrisoft.ro

# ===============================
# Frontend (Vite build-time API endpoints)
# Local dev: use localhost ports. Production: use API subdomain paths.
# ===============================
VITE_YOUTUBE_AUDIO_SERVICE_URL=https://bold-quokka-api.mitrisoft.ro/youtube
VITE_AUDIO_TEXT_SERVICE_URL=https://bold-quokka-api.mitrisoft.ro/audio
VITE_RAG_INDEXER_URL=https://bold-quokka-api.mitrisoft.ro/rag
VITE_CHAT_SERVICE_URL=https://bold-quokka-api.mitrisoft.ro/chat
VITE_DB_SERVICE_URL=https://bold-quokka-api.mitrisoft.ro/db
VITE_DEFAULT_COLLECTION=batem-palma

# ===============================
# Transcription model (Hugging Face Whisper)
# This is ASR/STT, not text-generation.
# ===============================
HF_TOKEN=your_huggingface_token_here
AUDIO_TEXT_SERVICE_WHISPER_MODEL_ID=distil-whisper/distil-large-v3

# ===============================
# pgAdmin
# ===============================
PGADMIN_DEFAULT_EMAIL=admin@boldquokka.local
PGADMIN_DEFAULT_PASSWORD=admin123

# ===============================
# Optional tuning knobs
# ===============================
CHAT_SERVICE_MIN_SCORE_THRESHOLD=0.25
CHAT_SERVICE_MAX_CONTEXT_CHARS=6500
RAG_INDEXER_MAX_CHUNK_TOKENS=350
RAG_INDEXER_CHUNK_OVERLAP_TOKENS=60
FROM node:22-alpine AS builder
WORKDIR /app

ARG VITE_YOUTUBE_AUDIO_SERVICE_URL
ARG VITE_AUDIO_TEXT_SERVICE_URL
ARG VITE_RAG_INDEXER_URL
ARG VITE_CHAT_SERVICE_URL
ARG VITE_DB_SERVICE_URL
ARG VITE_DEFAULT_COLLECTION

ENV VITE_YOUTUBE_AUDIO_SERVICE_URL=${VITE_YOUTUBE_AUDIO_SERVICE_URL}
ENV VITE_AUDIO_TEXT_SERVICE_URL=${VITE_AUDIO_TEXT_SERVICE_URL}
ENV VITE_RAG_INDEXER_URL=${VITE_RAG_INDEXER_URL}
ENV VITE_CHAT_SERVICE_URL=${VITE_CHAT_SERVICE_URL}
ENV VITE_DB_SERVICE_URL=${VITE_DB_SERVICE_URL}
ENV VITE_DEFAULT_COLLECTION=${VITE_DEFAULT_COLLECTION}

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
